          vpnHeadingA: "Off campus?",
          vpnHeadingB: "One less thing to connect.",
          vpnDescription: "With the option enabled, QAQ can try a campus VPN route when iStudy is not reachable directly, reducing manual connection steps.",
          vpnNotice: "An optional experimental feature. Availability and stability depend on your network.",
          vpnNodeOutside: "Off-campus",
          vpnNodeTunnel: "Try VPN route",
          vpnNodeCampus: "iStudy",
          vpnDiagramCaption: "Once enabled, QAQ helps pick a route to iStudy",
          themeEyebrow: "Light & dark themes",
          themeHeadingA: "Bright by day.",
          themeHeadingB: "Comfortable by night.",
          themeDescription: "Prefer a crisp light interface or a calmer dark one? Choose what feels right. The familiar pastel timetable colors stay with you.",
          themeTry: "Try the website theme",
          themeChoiceLight: "Light",
          themeChoiceDark: "Dark",
          communityEyebrow: "Made for everyday campus life",
          communityHeadingA: "A small app called QAQ.",
          communityHeadingB: "A simpler day at NTUT.",
          communityDescription: "QAQ is an independently maintained open-source project. Share ideas, report issues, or help make campus tools better for everyone.",
          communityDownload: "Get QAQ",
          communityGithub: "View on GitHub",
          showcaseAria: "QAQ timetable previews on a phone and a desktop",
          themeAria: "QAQ timetable shown in light and dark mode",
          themeGroup: "Try the website theme",
        },
      };

      const root = document.documentElement;
      const languageButton = document.querySelector('#language-toggle');
      const themeButton = document.querySelector('#theme-toggle');
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      const releaseLink = document.querySelector('#release-link');
      const releaseFallback = 'https://github.com/umeow0716/qaq-app/releases/latest';
      let language = localStorage.getItem('qaq-language') === 'en' ? 'en' : 'zh-Hant';

      const updateThemeLabel = () => {
        const dark = root.dataset.theme === 'dark';
        themeButton?.setAttribute('aria-label', dark ? translations[language].themeLight : translations[language].themeDark);
      };

      const applyLanguage = (next) => {
        language = next;
        root.lang = next;
        localStorage.setItem('qaq-language', next);
        document.querySelectorAll('[data-i18n]').forEach((node) => {
          const key = node.dataset.i18n;
          if (key && translations[next][key]) node.textContent = translations[next][key];
        });
        document.querySelectorAll('[data-i18n-aria]').forEach((node) => {
          const key = node.dataset.i18nAria;
          if (key && translations[next][key]) node.setAttribute('aria-label', translations[next][key]);
        });
        if (languageButton) {
          languageButton.textContent = next === 'zh-Hant' ? 'EN' : '中';
          languageButton.setAttribute('aria-label', next === 'zh-Hant' ? 'Switch to English' : '切換為繁體中文');
        }
        updateThemeLabel();
      };

      languageButton?.addEventListener('click', () => applyLanguage(language === 'zh-Hant' ? 'en' : 'zh-Hant'));
      const themeChoices = document.querySelectorAll('[data-set-theme]');
      const setTheme = (next) => {
        root.dataset.theme = next;
        root.style.colorScheme = next;
        localStorage.setItem('qaq-theme', next);
        themeMeta?.setAttribute('content', next === 'dark' ? '#1A1C1E' : '#FDFCFF');
        themeChoices.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.setTheme === next)));
        updateThemeLabel();
      };

      themeButton?.addEventListener('click', () => setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));
      themeChoices.forEach((button) => button.addEventListener('click', () => setTheme(button.dataset.setTheme)));


      const hydrateReleaseLinks = async () => {
        try {
          const response = await fetch('https://api.github.com/repos/umeow0716/qaq-app/releases/latest', {
            headers: { Accept: 'application/vnd.github+json' },
          });
          if (!response.ok) return;
          const release = await response.json();
          const assets = Array.isArray(release.assets) ? release.assets : [];
          const patterns = {
            'windows-msi': /-windows-x64\.msi$/i,
            'windows-zip': /-windows-x64\.zip$/i,
            'linux-appimage': /-linux-x86_64\.AppImage$/i,
            'linux-deb': /-linux-amd64\.deb$/i,
          };
          for (const [key, pattern] of Object.entries(patterns)) {
            const asset = assets.find((entry) => pattern.test(entry.name));
            const anchor = document.querySelector(`[data-download="${key}"]`);
            if (asset?.browser_download_url && anchor) anchor.href = asset.browser_download_url;
          }
          if (releaseLink) {
            releaseLink.href = release.html_url || releaseFallback;
            releaseLink.textContent = release.tag_name || 'GitHub Releases';
          }
        } catch {}
      };

      applyLanguage(language);
      setTheme(root.dataset.theme);
      hydrateReleaseLinks();
    </script>
  </body>
