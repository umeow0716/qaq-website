---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-Hant" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FDFCFF" />
    <meta name="description" content="QAQ 北科生活，整合課表、成績、行事曆與校務系統，讓北科學生快速找到每天需要的校園資訊。" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/qaq-mark.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/brand/qaq-mark.png" />
    <link rel="canonical" href="https://qaq.umeow.eu.org/" />
    <meta property="og:site_name" content="QAQ 北科生活" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="QAQ — 北科生活" />
    <meta property="og:description" content="課表、成績、行事曆與校務系統，整理在你每天都能快速找到的地方。" />
    <meta property="og:url" content="https://qaq.umeow.eu.org/" />
    <meta property="og:image" content="https://qaq.umeow.eu.org/brand/qaq-mark.png" />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "QAQ 北科生活",
        "alternateName": ["QAQ", "qaq.umeow.eu.org"],
        "url": "https://qaq.umeow.eu.org/"
      }
    </script>
    <title>QAQ — 北科生活</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('qaq-theme');
        const theme = saved === 'light' || saved === 'dark'
          ? saved
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>

  <body>
    <main class="page" id="top">
      <header class="site-header" aria-label="QAQ">
        <a class="brand" href="/" aria-label="QAQ home">
          <img class="brand-mark" src="/brand/qaq-mark.png" width="34" height="34" alt="" />
          <span class="brand-name">QAQ</span>
        </a>

        <div class="header-actions">
          <a class="header-button" href="https://github.com/umeow0716/qaq-app" target="_blank" rel="noreferrer" aria-label="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.28-1.29-5.28-5.68 0-1.25.45-2.28 1.19-3.08-.12-.3-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.5 3.16-1.18 3.16-1.18.63 1.58.23 2.75.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.4-2.72 5.38-5.3 5.67.42.36.79 1.06.79 2.14v3.18c0 .31.2.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
            <span class="github-label">GitHub</span>
          </a>
          <button class="header-button" id="language-toggle" type="button" aria-label="Switch language">EN</button>
          <button class="header-button" id="theme-toggle" type="button" aria-label="切換深色模式">
            <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg>
            <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.2 15.2A8.4 8.4 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z"/></svg>
          </button>
        </div>
      </header>

      <section class="hero" aria-labelledby="hero-title">
        <!-- Small asymmetric ambient forms replace the former full-width wave at the fold. -->
        <div class="hero-atmosphere" aria-hidden="true">
          <span class="ambient-ripple ambient-ripple-left"></span>
          <span class="ambient-ripple ambient-ripple-right"></span>
        </div>
        <div class="hero-inner">
          <div class="hero-lockup">
            <div class="hero-icon-tile" aria-hidden="true">
              <img class="hero-mark" src="/brand/qaq-symbol.png" width="92" height="92" alt="" />
            </div>
            <p class="kicker" data-i18n="kicker">北科校園生活</p>
          </div>
          <h1 id="hero-title" data-i18n="title">北科生活，一個 QAQ 就夠。</h1>
          <p class="hero-copy" data-i18n="lead">課表、成績、行事曆與校務系統，整理在你每天都能快速找到的地方。</p>

          <div class="downloads" id="downloads" aria-label="Downloads">
            <a class="download-button primary" data-download="windows-msi" href="https://github.com/umeow0716/qaq-app/releases/latest">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M3 4.1 10.5 3v8.3H3V4.1Zm8.5-1.25L21 1.5v9.8h-9.5V2.85ZM3 12.3h7.5v8.35L3 19.6v-7.3Zm8.5 0H21v10.2l-9.5-1.34V12.3Z"/></svg>
              <span class="button-copy"><span class="button-title" data-i18n="windowsInstall">Windows 安裝版</span><span class="button-meta">MSI · x64</span></span>
            </a>
            <a class="download-button" data-download="windows-zip" href="https://github.com/umeow0716/qaq-app/releases/latest">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4"/><path d="M5 19h14"/></svg>
              <span class="button-copy"><span class="button-title" data-i18n="windowsPortable">Windows 免安裝</span><span class="button-meta">ZIP · x64</span></span>
            </a>
            <a class="download-button" data-download="linux-appimage" href="https://github.com/umeow0716/qaq-app/releases/latest">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="m7 9 3 3-3 3m5 0h5"/></svg>
              <span class="button-copy"><span class="button-title">Linux AppImage</span><span class="button-meta">AppImage · x64</span></span>
            </a>
            <a class="download-button" data-download="linux-deb" href="https://github.com/umeow0716/qaq-app/releases/latest">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l3 3v15H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></svg>
              <span class="button-copy"><span class="button-title">Linux Debian</span><span class="button-meta">DEB · amd64</span></span>
            </a>
            <a class="download-button" data-platform="play" href="https://play.google.com/store/apps/details?id=dev.umeow.qaq" target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="m3.7 2.75 10.07 9.2-10.05 9.28A2.1 2.1 0 0 1 3 19.64V4.34c0-.63.26-1.2.7-1.59Zm11.3 10.3 2.66 2.43-10.5 5.94L15 13.05Zm3.85-3.5 1.54.87c.81.46.81 1.63 0 2.09l-1.52.86-2.63-2.4 2.61-2.42ZM7.2 2.57l10.47 5.91L15 10.93 7.2 2.57Z"/></svg>
              <span class="button-copy"><span class="button-title">Google Play</span><span class="button-meta">Android</span></span>
            </a>
          </div>

          <p class="release-line"><span data-i18n="latest">最新版本</span> <a id="release-link" href="https://github.com/umeow0716/qaq-app/releases/latest">GitHub Releases</a></p>
        </div>
      </section>

      <a class="hero-scroll-cue" href="#features"><span data-i18n="explore">往下看看 QAQ</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 9 7 7 7-7"/></svg></a>

      <!-- 01 / One calm place for everyday campus life -->
      <section class="story-section everyday-section" id="features" aria-labelledby="everyday-title">
        <div class="story-layout">
          <div class="story-copy">
            <p class="story-eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span><span data-i18n="everydayEyebrow">校園日常，整理好了</span></p>
            <h2 id="everyday-title"><span data-i18n="everydayHeadingA">想看的，都在這裡。</span><span class="heading-accent" data-i18n="everydayHeadingB">少一點切換，多一點從容。</span></h2>
            <p class="story-description" data-i18n="everydayDescription">今天有哪些課、成績更新了沒、下週有什麼行程。課表、成績和行事曆，不必再分開找。</p>
            <div class="feature-tags" aria-label="QAQ features">
              <span class="feature-tag"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M7.7 3v4M16.3 3v4M3.5 10h17M8 14h3m-3 3.2h3"/></svg><span data-i18n="featureSchedule">課表與教室</span></span>
              <span class="feature-tag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5h16M6.5 16V11m5.5 5V5m5.5 11V8"/></svg><span data-i18n="featureGrades">成績查詢</span></span>
              <span class="feature-tag"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M7.5 3v4m9-4v4M3.5 10h17m-12 5 2 2 4-4"/></svg><span data-i18n="featureCalendar">行事曆</span></span>
            </div>
          </div>
          <div class="story-art showcase-stage" role="img" aria-label="QAQ 課表在手機與電腦上的預覽" data-i18n-aria="showcaseAria">
            <div class="art-shape showcase-blob" aria-hidden="true"></div>
            <div class="art-halo halo-one" aria-hidden="true"></div>
            <div class="desktop-preview" aria-hidden="true">
              <div class="desktop-preview-bar"><span class="window-dots"><i></i><i></i><i></i></span><span class="desktop-preview-title">QAQ / Desktop</span></div>
              <img src="/previews/timetable-desktop.webp" width="1080" height="594" alt="" loading="lazy" decoding="async" />
            </div>
            <div class="mobile-preview showcase-mobile" aria-hidden="true">
              <div class="mobile-preview-bezel"><img src="/previews/timetable-light.webp" width="525" height="1054" alt="" loading="lazy" decoding="async" /></div>
            </div>
            <div class="floating-icon floating-icon-calendar" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="8.5" y="11.5" width="31" height="28" rx="7" stroke-width="2.8"/><path d="M16 8v8m16-8v8M9 21.5h30" stroke-width="2.8"/><path d="m18.5 29.3 4.3 4.1 7.2-8" stroke-width="3"/></svg>
            </div>
            <div class="floating-icon floating-icon-book" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.9" stroke-linejoin="round" stroke-linecap="round"><path d="M24 13c-4.6-3.3-9.6-3.5-15-2.3v24.6c5.4-1.2 10.4-1 15 2.4 4.6-3.4 9.6-3.6 15-2.4V10.7C33.6 9.5 28.6 9.7 24 13Z"/><path d="M24 13v24.7"/></svg>
            </div>
            <div class="art-label showcase-label"><span class="art-label-dot"></span><span data-i18n="showcaseLabel">每一天，用 QAQ 開始</span></div>
          </div>
        </div>
      </section>

      <!-- 02 / Cross-platform, with an original schematic SVG/CSS illustration -->
      <section class="story-section platform-section" id="platforms" aria-labelledby="platform-title">
        <div class="story-layout story-layout-reversed">
          <div class="story-art platform-stage" aria-hidden="true">
            <div class="art-shape platform-blob"></div>
            <div class="platform-orbit platform-orbit-outer"></div>
            <div class="platform-orbit platform-orbit-inner"></div>
            <div class="platform-desktop">
              <div class="platform-desktop-top"><div class="platform-dots"><i></i><i></i><i></i></div><span>QAQ</span><svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
              <div class="platform-desktop-content">
                <div class="platform-rail"><span class="rail-active"></span><span></span><span></span><span></span></div>
                <div class="platform-calendar-ui">
                  <div class="calendar-ui-top"><span></span><span></span><span></span></div>
                  <div class="calendar-ui-grid"><i class="ui-block peach"></i><i class="ui-block blue"></i><i class="ui-block lilac"></i><i class="ui-block mint"></i><i class="ui-block yellow"></i><i class="ui-block sky"></i></div>
                  <div class="calendar-ui-bottom"><span></span><span></span><span></span><span></span></div>
                </div>
              </div>
            </div>
            <div class="platform-handset">
              <div class="handset-speaker"></div>
              <div class="handset-appbar"><img src="/brand/qaq-symbol.png" alt="" width="28" height="28"/><span>QAQ</span></div>
              <div class="handset-content"><div class="handset-date"></div><div class="handset-days"><i></i><i></i><i></i><i></i><i></i></div><div class="handset-courses"><b></b><b></b><b></b><b></b><b></b></div></div>
              <div class="handset-bottom"><i></i><i></i><i></i><i></i></div>
            </div>
            <div class="platform-pill platform-pill-windows"><svg viewBox="0 0 24 24" fill="currentColor"><path d="m3 5 7.3-1v7.5H3V5Zm8.5-1.2L21 2.5v9h-9.5V3.8ZM3 12.5h7.3V20L3 19v-6.5Zm8.5 0H21v9l-9.5-1.3v-7.7Z"/></svg><span>Windows</span></div>
            <div class="platform-pill platform-pill-linux"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="m7 9 3 3-3 3m5 0h5"/></svg><span>Linux</span></div>
            <div class="platform-pill platform-pill-android"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M6 10a6 6 0 0 1 12 0M8 5.5 6.5 3M16 5.5 17.5 3M5 11h14v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-6ZM2 12v5m20-5v5M9 20v2m6-2v2"/><circle cx="9" cy="9" r=".7" fill="currentColor" stroke="none"/><circle cx="15" cy="9" r=".7" fill="currentColor" stroke="none"/></svg><span>Android</span></div>
          </div>
          <div class="story-copy">
            <p class="story-eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span><span data-i18n="platformEyebrow">跨平台支援</span></p>
            <h2 id="platform-title"><span data-i18n="platformHeadingA">手機、電腦，</span><span class="heading-accent" data-i18n="platformHeadingB">都可以很 QAQ。</span></h2>
            <p class="story-description" data-i18n="platformDescription">Android、Windows 與 Linux 都有對應的使用方式。從書桌前到通勤路上，熟悉的校園資訊隨手可得。</p>
            <p class="story-footnote" data-i18n="platformFootnote">專案亦支援 iOS / iPadOS；公開下載選項請以實際發行版本為準。</p>
            <a class="text-link" href="#downloads"><span data-i18n="platformAction">查看下載選項</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7"/></svg></a>
          </div>
        </div>
      </section>

      <!-- 03 / iStudy-only experimental off-campus VPN assistance -->
      <section class="story-section vpn-section" id="vpn" aria-labelledby="vpn-title">
        <div class="story-layout">
          <div class="story-copy">
            <p class="story-eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span><span data-i18n="vpnEyebrow">i 學園 · 實驗性功能</span></p>
            <h2 id="vpn-title"><span data-i18n="vpnHeadingA">人在校外，</span><span class="heading-accent" data-i18n="vpnHeadingB">也少一點連線麻煩。</span></h2>
            <p class="story-description" data-i18n="vpnDescription">開啟設定後，當 i 學園無法直接連線，QAQ 會嘗試透過校園 VPN 建立存取路徑，不用每次都手動處理連線。</p>
            <div class="notice-line"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5m0-8h.01"/></svg><span data-i18n="vpnNotice">目前為可選用的實驗性功能；實際連線狀況依網路環境而異。</span></div>
          </div>
          <div class="story-art vpn-stage" aria-hidden="true">
            <div class="art-shape vpn-blob"></div>
            <svg class="vpn-route-art" viewBox="0 0 620 440" fill="none" preserveAspectRatio="xMidYMid meet"><path d="M104 223 C190 120 230 130 309 214 S476 305 526 206" stroke="currentColor" stroke-width="2.8" stroke-dasharray="5 13" stroke-linecap="round"/><path d="M110 244 C184 326 239 318 310 234" stroke="currentColor" stroke-width="1.2" opacity=".28"/><path d="M317 225 C370 133 450 132 521 199" stroke="currentColor" stroke-width="1.2" opacity=".28"/></svg>
            <div class="vpn-node vpn-node-outside"><svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M10 23c10-10 26-10 36 0M17 30c6-6 16-6 22 0m-15 7a6 6 0 0 1 8 0" stroke-width="3"/><circle cx="28" cy="43" r="3.5" fill="currentColor" stroke="none"/></svg><span data-i18n="vpnNodeOutside">校外網路</span></div>
            <div class="vpn-node vpn-node-tunnel"><span class="vpn-shield-ring"><svg viewBox="0 0 72 72" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"><path d="M36 8 58 16v18c0 16-9 25-22 31C23 59 14 50 14 34V16L36 8Z"/><path d="m25 36 8 8 15-17"/></svg></span><span data-i18n="vpnNodeTunnel">自動嘗試 VPN</span></div>
            <div class="vpn-node vpn-node-campus"><svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="2.9" stroke-linejoin="round" stroke-linecap="round"><path d="m6 24 22-15 22 15M11 24v23h34V24M7 47h42M22 47V32h12v15M16 27h.1M40 27h.1"/></svg><span data-i18n="vpnNodeCampus">i 學園</span></div>
            <div class="vpn-route-note"><span class="vpn-route-note-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m5 12 4 4 10-10"/></svg></span><span data-i18n="vpnDiagramCaption">開啟設定後，由 QAQ 協助選擇連線方式</span></div>
            <span class="small-spark spark-vpn-one"></span><span class="small-spark spark-vpn-two"></span>
          </div>
        </div>
      </section>

      <!-- 04 / Real light and dark QAQ screenshots, composed as two objects -->
      <section class="story-section theme-section" id="themes" aria-labelledby="theme-title">
        <div class="story-layout story-layout-reversed">
          <div class="story-art theme-stage" role="img" aria-label="QAQ 淺色與深色課表的並排比較" data-i18n-aria="themeAria">
            <div class="art-shape theme-blob" aria-hidden="true"></div>
            <div class="theme-preview-phone preview-light" aria-hidden="true"><div class="theme-phone-screen"><img src="/previews/timetable-light.webp" alt="" width="525" height="1054" loading="lazy" decoding="async" /></div></div>
            <div class="theme-preview-phone preview-dark" aria-hidden="true"><div class="theme-phone-screen"><img src="/previews/timetable-dark.webp" alt="" width="525" height="1054" loading="lazy" decoding="async" /></div></div>
            <span class="theme-floating-symbol symbol-sun" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.6"><circle cx="20" cy="20" r="7"/><path d="M20 3v5m0 24v5M3 20h5m24 0h5M8 8l3.5 3.5m17 17L32 32M8 32l3.5-3.5M28.5 11.5 32 8"/></svg></span>
            <span class="theme-floating-symbol symbol-moon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.6"><path d="M33 28A14 14 0 0 1 13 8a14 14 0 1 0 20 20Z"/></svg></span>
          </div>
          <div class="story-copy">
            <p class="story-eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span><span data-i18n="themeEyebrow">亮色與深色主題</span></p>
            <h2 id="theme-title"><span data-i18n="themeHeadingA">白天清爽，</span><span class="heading-accent" data-i18n="themeHeadingB">晚上也舒服。</span></h2>
            <p class="story-description" data-i18n="themeDescription">喜歡明亮乾淨，或是低調的深色介面，都可以選你習慣的樣子。課表裡那些柔和的色塊，也跟著保留。</p>
            <div class="theme-controls" role="group" aria-label="網站主題試用" data-i18n-aria="themeGroup">
              <span class="theme-controls-label" data-i18n="themeTry">順手試試這個網站的主題</span>
              <div class="theme-choice-group">
                <button type="button" class="theme-choice" data-set-theme="light" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg><span data-i18n="themeChoiceLight">亮色</span></button>
